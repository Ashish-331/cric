# Cric — Shared Platform Environment Template
# Copy this file to .env.local for local overrides. Never commit .env.local to git.

# 1. Supabase Backend Connection (Public Client Configuration)
# Local development default: http://127.0.0.1:54321
# Hosted project format: https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Project Publishable Key (or legacy anon key)
# For local Supabase CLI, this is the standard development anon key
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJpYXQiOjE2ODAwMDAwMDAsImV4cCI6MjAwMDAwMDAwMH0.MOCK_ANON_KEY_FOR_LOCAL_DEV

# 2. Operational Environment Flag
EXPO_PUBLIC_APP_ENV=development

# IMPORTANT SECURITY RULES:
# - NEVER commit secrets or production credentials.
# - NEVER expose SUPABASE_SERVICE_ROLE_KEY in frontend EXPO_PUBLIC_* variables.
# - Carrier SMS provider credentials remain blocked pending approval.
